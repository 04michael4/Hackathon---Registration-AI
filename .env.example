# Copy to .env and fill in locally. NEVER commit .env.
# Placeholder values only — no real credentials belong in this file.

# --- Backend (used now) ---
# Port the Spring Boot API listens on (defaults to 8080 if unset).
PORT=8080
# Comma-separated exact frontend origins, without trailing slashes. No wildcards.
# Set to an empty value to disable cross-origin access (e.g. with a Next.js proxy).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Positive integer scheduling exploration cap. Invalid values fail startup.
SCHEDULING_NODE_CAP=200000

# --- PostgreSQL (required only when CATALOG_SOURCE=database) ---
# DB_URL=jdbc:postgresql://localhost:5432/registration
# DB_USERNAME=registration
# DB_PASSWORD=change-me
# Existing catalog schema; the application never creates tables or imports data on startup.
CATALOG_SCHEMA=cse007_snapshot

# --- Course catalog (used now) ---
# dummy (default) = AI development only | database = authoritative PostgreSQL catalog
# Course endpoints require database mode; they never serve the AI dummy's made-up courses.
CATALOG_SOURCE=dummy

# --- AI preference extraction (used now) ---
# none (default) = endpoint returns 503
# dummy          = fixed example, no API key needed
# claude         = real Claude API (needs ANTHROPIC_API_KEY; without it the endpoint returns 503)
AI_PROVIDER=none

# --- Anthropic Claude API (used only when AI_PROVIDER=claude) ---
# Your own key from the Anthropic Console. Keep it in your local .env or shell; never commit it.
# ANTHROPIC_API_KEY=your-key-here
# Optional; defaults to claude-haiku-5-5 (fast, low-cost; set in application.properties)
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Frontend (not used yet) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
