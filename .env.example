# Copy to .env and fill in locally. NEVER commit .env.
# Placeholder values only — no real credentials belong in this file.
# Windows: backend/start-local.ps1 loads this private root .env into the backend process.
# Direct Maven/Java commands still require exported environment variables.

# --- Backend (used now) ---
# Port the Spring Boot API listens on (defaults to 8080 if unset).
PORT=8080
# Comma-separated exact frontend origins, without trailing slashes. No wildcards.
# Set to an empty value to disable cross-origin access (e.g. with a Next.js proxy).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Positive integer scheduling exploration cap. Invalid values fail startup.
SCHEDULING_NODE_CAP=200000

# --- PostgreSQL (used only when CATALOG_SOURCE=database) ---
# Read-only access to the catalog_api views (see data/catalog-api/). Never commit real values.
# DB_URL=jdbc:postgresql://localhost:5432/registration
# DB_USERNAME=registration
# DB_PASSWORD=change-me
# Leave DB_PASSWORD unset to let the PostgreSQL driver read the password from a PGPASSFILE.
# Which views the backend reads: catalog_api (default), catalog_live (adds approved, promoted courses; see data/catalog-promotion) or
# catalog_serving (the researched READY and CONDITIONAL courses, served with their conditions; see data/catalog-serving).
# DB_CATALOG_SCHEMA=catalog_api

# --- Course catalog (used now) ---
# database (default) = authoritative PostgreSQL catalog_api views; DB_URL and DB_USERNAME are required.
# Synthetic Course/Section catalogs exist only in test sources and are not packaged in the application.
CATALOG_SOURCE=database
# demo = a local, feature-flagged Spring 2027 demo catalog (README section 4b); it needs DEMO_FIXTURE_PATH, a file kept OUTSIDE the repository.
# DEMO_FIXTURE_PATH=/path/to/spring-2027.json

# --- AI preference extraction (used now) ---
# none (default) = endpoint returns 503
# dummy          = fixed example, no API key needed
# claude         = real Claude API (needs ANTHROPIC_API_KEY; without it the endpoint returns 503)
AI_PROVIDER=none

# --- Anthropic Claude API (used only when AI_PROVIDER=claude) ---
# Your own key from the Anthropic Console. Keep it in your local .env or shell; never commit it.
# ANTHROPIC_API_KEY=your-key-here
# Optional; defaults to claude-haiku-5-5 (fast, low-cost; set in application.properties)
# ANTHROPIC_MODEL=claude-haiku-5-5

# --- Frontend integration (private app only) ---
# Set in frontend/.env.local or the Next.js server environment; see frontend/.env.example.
# Missing BACKEND_URL shows an actionable error; normal mode never falls back to demo data.
# Instructor names are real: leave unset on public deployments until Banner redistribution is settled.
# BACKEND_URL=http://127.0.0.1:8080
# FRONTEND_MODE=api
# Set FRONTEND_MODE=demo only for the explicitly labeled offline prototype.
