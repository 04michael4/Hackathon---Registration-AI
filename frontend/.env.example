# Copy to .env.local without overwriting an existing developer configuration.
# Next.js server-only URL. Browser requests use the same-origin /api/backend proxy.
BACKEND_URL=http://127.0.0.1:8080
# api is the default. demo explicitly selects the offline prototype.
FRONTEND_MODE=api
# Do not put database credentials or AI keys in this file or in NEXT_PUBLIC_* variables.
